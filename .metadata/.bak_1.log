		try (BufferedReader reader = new BufferedReader(new FileReader(fileToRead))) 
        {
        	String line;
        	int i = 0;
            while ((line = reader.readLine()) != null) 
            {
            	cloudletlengths[i] = Long.parseLong(line);
    			i++;
            }
        }
        catch (IOException e) 
        {
