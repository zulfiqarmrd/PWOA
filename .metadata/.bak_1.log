            	i++;
            }
        }
        catch (IOException e) 
        {
            e.printStackTrace();
        } 
            
        for (int i=0; i < cloudlets; i++)
        {
        	length = cloudletlengths[i];
        	cloudlet[i] = new Cloudlet(idShift + i, length, pesNumber, fileSize, outputSize, 
										utilizationModel, utilizationModel, utilizationModel);
			cloudlet[i].setUserId(userId);
			list.add(cloudlet[i]);
        }    
        return list;
        }
        
