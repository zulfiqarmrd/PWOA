		private static void printCharts(JFreeChart chart, String metric)
		 {		 
			 CategoryPlot plot = (CategoryPlot) chart.getPlot();
			 plot.setBackgroundPaint(new Color(255, 255, 255)); // Set background color
			 
			 ValueAxis yAxis = plot.getRangeAxis();
			 plot.setRangeAxis(yAxis);
		     Font fontY = new Font("caliberi", Font.TRUETYPE_FONT, 23); // Replace with your desired font and size
		     yAxis.setTickLabelFont(fontY);
			 
			 LineAndShapeRenderer renderer = (LineAndShapeRenderer) plot.getRenderer();
			 renderer.setSeriesPaint(0, Color.red); // Set color for series 1
			 renderer.setSeriesPaint(1, Color.green); // Set color for series 2
			 renderer.setSeriesPaint(2, Color.CYAN); // Set color for series 3
			 renderer.setSeriesPaint(3, Color.BLACK); // Set color for series 4
			 renderer.setSeriesPaint(4, Color.magenta); // Set color for series 5
			 renderer.setSeriesPaint(5, Color.blue); // Set color for series 6
			 renderer.setDefaultShapesVisible(true); // Show data points as shapes

			 renderer.setDefaultStroke(new BasicStroke(1.5f)); // width of each line
			 renderer.setAutoPopulateSeriesStroke(false);
			 renderer.setAutoPopulateSeriesOutlineStroke(true);
			 
			 /*Increasing the font size */
				// Increase the font size for the axis labels
				 Font axisLabelFont = plot.getDomainAxis().getLabelFont();
				 Font newAxisLabelFont = axisLabelFont.deriveFont(axisLabelFont.getSize2D() * 1.5f);
				 plot.getDomainAxis().setLabelFont(newAxisLabelFont);

				 // Increase the font size for the tick labels on the domain axis
				 Font tickLabelFont = plot.getDomainAxis().getTickLabelFont();
				 Font newTickLabelFont = tickLabelFont.deriveFont(tickLabelFont.getSize2D() * 1.5f);
				 plot.getDomainAxis().setTickLabelFont(newTickLabelFont);

			     Font newAxisLabelFont2 = new Font("calibri", 0, 25);;
			     yAxis.setLabelFont(newAxisLabelFont2); // Set the font for the y-axis label
				 
			     CategoryAxis xAxis = (CategoryAxis) plot.getDomainAxis();
			     Font fontX = new Font("calibri", 0, 25);
			     xAxis.setLabelFont(fontX); // Set the font for tick labels on the x-axis	     
			     
				 // Increase the font size for the legend
				 Font font = new Font("caliberi", 0, 25);
				 chart.getLegend().setItemFont(font);

				 ChartPanel chartPanel = new ChartPanel(chart);
				 chartPanel.setPreferredSize(new Dimension(1700, 1000));
				 
				 JFrame frame = new JFrame(metric);
			     frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
			     frame.getContentPane().add(chartPanel, BorderLayout.CENTER);
			     frame.pack();
//			     frame.setVisible(true);
	     try  {

             DOMImplementation mySVGDOM= GenericDOMImplementation.getDOMImplementation();
             /* create Document object */
             Document document = mySVGDOM.createDocument(null, "svg", null);
             /* Create SVG Generator */
             SVGGraphics2D my_svg_generator = new SVGGraphics2D(document);
             /* Render chart as SVG 2D Graphics object */
             chart.draw(my_svg_generator, new Rectangle2D.Double(0, 0, 1200, 500), null);
             /* Write output to file */
             my_svg_generator.stream(metric+".svg");            

	     } 
	     catch (IOException e) 
	     {
	         e.printStackTrace();
	     }
}
