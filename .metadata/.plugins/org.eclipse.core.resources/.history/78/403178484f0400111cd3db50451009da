	 * @param sortedVmList - a list of sorted Vms
	 * @param sortedCloudletList - a list of sorted Cloudlets
	 * 
	 * @return an ArrayList of Chromosomes
	 */
	public static ArrayList<Chromosomes> initialisePopulation(int numCloudlets, int numVms, ArrayList<Vm> sortedVmList, List<Cloudlet> sortedCloudletList) 
	{
		
		ArrayList<Chromosomes> initialPopulation = new ArrayList<Chromosomes>();
		
		for(int j = 0; j < noOfChromosomes; j++) 		/* Population size is 50 as given on page 6 (second column)-first paragraph, but according to point 13, 
																											 it needs to be equally divided by 4.*/ 
		{
			ArrayList<Gene> firstChromosome = new ArrayList<Gene>();
			
			Random rand = new Random();
			for(int i = 0; i < numCloudlets; i++){
				
/*				int k = (i + j) % numVms;
				k = (k + numCloudlets) % numCloudlets;     // ensures the vm not to exceed the max number of vms*/
				int k = rand.nextInt(vmlist.size());		// The random function produces better results than the above approach		
				
				// j-th chromosome's gene list will start with j-th vm from the sortedVmList.
				Gene geneObj = new Gene(sortedCloudletList.get(i), sortedVmList.get(k));
				
