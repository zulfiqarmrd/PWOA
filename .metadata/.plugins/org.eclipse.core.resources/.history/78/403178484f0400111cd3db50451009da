				Vm vm = g.getVmFromGene();
				double execTime = c.getCloudletLength()/vm.getMips();
				updateUpVMRTMap(VMRTMap, vm, execTime);
//				System.out.println("Execution Time of Cloudlet: " + c.getCloudletId() + " on vm " + vm.getId()+" is: " + execTime + " chromosome No. "+i);
			}

			best1ChromosomeMakespan = getpbMap(VMRTMap);
/*			System.out.println("Accumulated bestChromosomeMakespan: " + best1ChromosomeMakespan + " in chromosome: "+ i);
			System.out.println("---------------------------------------------------");*/
			
			//if bestChromosomeMakespan of this i-th chromosome is the least, then mark it the fittest
			if(best1ChromosomeMakespan < bestChromosomeMakespan)
			{
//				System.out.println("Previous best chromosome's bestChromosomeMakespan: " + bestChromosomeMakespan);
				bestChromosomeMakespan = best1ChromosomeMakespan;
				
				ArrayList<Gene> final_Gene_list = l;
				for(Gene g : final_Gene_list)
				{
					gbFMap.put(g.getCloudletFromGene(), g.getVmFromGene());
				}
				
				secondbestChromosomeIndex = bestChromosomeIndex ;
				bestChromosomeIndex  = i;
/*				System.out.println("*New best chromosome inside fitness: " + i + " with bestChromosomeMakespan: " + best1ChromosomeMakespan+ " with bestChromosomeIndex : "+bestChromosomeIndex  + " secondbestChromosomeIndex: "+secondbestChromosomeIndex+"\n");
				System.out.println("-----------------------------------------------------------------------");*/
}
		}
		
		return new double[] {bestChromosomeIndex , secondbestChromosomeIndex, bestChromosomeMakespan};
	}
	
	private static double getpbMap(HashMap<Integer, Double> VMRTMap) 	// Returns the busiest VM -- It is also a fitness function
	{
		double busyVm = 0.0;
		
		for (HashMap.Entry<Integer, Double> entry : VMRTMap.entrySet()) 
		{
			double vmRt = entry.getValue();
			
			if (vmRt > busyVm)
	        {
				busyVm = vmRt; 
	        }
	    }
//		System.out.println("The pBest of particle is: "+ busyVm);
		return busyVm;
	}	

	
	private static void updateUpVMRTMap(HashMap<Integer, Double> vmRemMap, Vm VM, double execTime) 
	{
		int vmid = VM.getId();
		double prevLoad = 0.0;
		
		if (vmRemMap.containsKey(vmid))
		{
			prevLoad = vmRemMap.get(vmid);
		}
		else 
		{
			System.out.println("vmid is not found in updateUpVMRTMap \n");
		}
		
		double totalLoad = prevLoad + execTime;
//		System.out.println("Put new load: "+execTime+ "|Current Load: " + totalLoad + "\n");

		vmRemMap.put(vmid, totalLoad);
	}

	/**
	 * Selects the first and second, most fit Chromosomes and cross-breeds them.
	 * 
	 * @param initialPopulation - list of chromosomes
	 * @param firstFitIndex - index denoting most fit chromosome
	 * @param secondFitIndex - index denoting second most fit chromosome
	 * @param numCloudlets - number of cloudlets
	 */
	public static void selectionAndCrossOver(ArrayList<Chromosomes> initialPopulation, int firstFitIndex, int secondFitIndex,
										int numCloudlets) {
		// SELECTION
		int index1,index2;			
		index1 = firstFitIndex;
		index2 = secondFitIndex;
		
		// Store their chromosomes and genelists
		ArrayList<Gene> l1 = new ArrayList<Gene>();
		l1 = initialPopulation.get(index1).getGeneList();
		Chromosomes chromosome1 = new Chromosomes(l1);		// best chromosome
		
		ArrayList<Gene> l2 = new ArrayList<Gene>();
		l2 = initialPopulation.get(index2).getGeneList();
		Chromosomes chromosome2 = new Chromosomes(l2);		// secondBest chromosome
		
		// CROSSOVER			
		Random random = new Random();
		int swap_index_limit;
		swap_index_limit = random.nextInt(numCloudlets) % numCloudlets;	// generate a random point of division in a chromosome

		// Swap VMs among two genelist
		for(int j = 0; j <= swap_index_limit; j++) 
		{
			Vm vm1 = l1.get(j).getVmFromGene();
			Vm vm2 = l2.get(j).getVmFromGene();
			// Update the two chromosomes
			chromosome1.updateGene(j, vm2);	
			chromosome2.updateGene(j, vm1);	
		}
		
		// Update population
		initialPopulation.set(index1, chromosome1);		// son
		initialPopulation.set(index2, chromosome2);		// daughter
	}
	
	/**
	 * Mutates a random Chromosome by replacing a random VM by the VM with most mips.
	 * 
	 * @param rand - an object of class Random
	 * @param initialPopulation - list of chromosomes
	 * @param populationSize - number of chromosomes in the population
	 * @param sortedVmList - a list of sorted Vms
	 * @param numCloudlets - number of cloudlets
	 */
	public static void mutation(Random rand, ArrayList<Chromosomes> initialPopulation, int populationSize, ArrayList<Vm> sortedVmList, int numCloudlets) 
	{
		int m = rand.nextInt(populationSize);
		
		// Mutation Chromosome
		ArrayList<Gene> l = new ArrayList<Gene>();
		l = initialPopulation.get(m).getGeneList();			// l is a random chromosome
		Chromosomes mutchromosome = new Chromosomes(l);	

		int randGeneIndex1 = rand.nextInt(l.size());
		int randGeneIndex2 = rand.nextInt(l.size());
		
		ArrayList<Gene> allGenes = mutchromosome.getGeneList();

		Gene gene1 = allGenes.get(randGeneIndex1);
		Gene gene2 = allGenes.get(randGeneIndex2);
		
		int cldId1 = gene1.getCloudletFromGene().getCloudletId();
//		System.out.println("The old cldId1 is: "+cldId1);
		cldId1 = cldId1%numCloudlets;	/* The modulus operator with numCloudlets keeps the cldId into the range noOfCloudlets. 
										It is important because in the raw files, the rows are randomly taken having huge 
											cloudlet ids.*/
//		System.out.println("The new cldId1 is: "+cldId1+"\n");
		Vm vm1 = gene1.getVmFromGene();

		int cldId2 = gene2.getCloudletFromGene().getCloudletId();
//		System.out.println("The old cldId2 is: "+cldId2);

		cldId2 = cldId2%numCloudlets;
//		System.out.print("The new cldId2 is: "+ cldId2 + "\n");

		Vm vm2 = gene2.getVmFromGene();
		
		mutchromosome.updateGene(cldId1, vm2);		
		mutchromosome.updateGene(cldId2, vm1);		
	}
