	public static void average(String read, String write) 
	{
				
		String fileToRead = read; 
	
		try (BufferedReader br = new BufferedReader(new FileReader(fileToRead))) 
		{
	        String line;
	        double avgMakespan = 0.0;
	        double avgARU = 0.0;
	        double avgaRT = 0.0;
	        double avgthroughput = 0.0;
	        double avgExecutionTime = 0.0;
	        
	        while ((line = br.readLine()) != null) 
	        {
	            // Split the line into individual values using the comma as the delimiter
	            String[] values = line.split(",");

	            // Process the values as needed
	            Double makespan = Double.parseDouble(values[0]);
	            Double ARU = Double.parseDouble(values[1]);
	            Double aRT = Double.parseDouble(values[2]);
	            Double throughput = Double.parseDouble(values[3]);
	            Double executionTime = Double.parseDouble(values[4]);

	            avgMakespan = avgMakespan + makespan;
	            avgARU = avgARU + ARU;
	            avgaRT = avgaRT + aRT;
	            avgthroughput = avgthroughput + throughput;
	            avgExecutionTime = avgExecutionTime + executionTime;
	        }

//		        System.out.println("The results are for length:"+tasks);
	        System.out.println("Average makespan: " + avgMakespan/10);
	        System.out.println("Average ARU: " + avgARU/10);
	        System.out.println("Average aRT: " + avgaRT/10);
	        System.out.println("Average throughput: " + avgthroughput/10);
	        System.out.println("Average throughput: " + avgExecutionTime/10+"\n");

			try
	    	{	// The first row contains the result for 100 tasks while the last row represents 1000 tasks average.
	    		String fileToWrite = write;
	    		FileWriter fWriter = new FileWriter(fileToWrite,true);
	    		BufferedWriter bWriter = new BufferedWriter(fWriter);
	    		bWriter.write(avgMakespan/10 + ", "+ avgARU/10+ ", "+ avgaRT/10+", "+ avgthroughput/10 +", "+ avgExecutionTime/10 + "\n");
	    		bWriter.close();
	    		fWriter.close();
	    	}
	    	catch(IOException e)
	    	{
	    		System.out.println("An error occurred while writing to the file: " + e.getMessage());
	    	}

		} catch (IOException e) 
		{
			e.printStackTrace();
		}
	}
